{
  "name": "@phyniqs/playwright-scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/migrate.js",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "bullmq": "^5.58.5",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
